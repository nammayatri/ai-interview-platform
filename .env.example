# AI Interview Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# Deepgram (STT + TTS) - Get free key at console.deepgram.com
DEEPGRAM_API_KEY=

# AI Model (any OpenAI-compatible endpoint)
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4o

# Database
DATABASE_URL=postgresql://postgres@localhost:5432/ai_interview_platform

# NextAuth
NEXTAUTH_SECRET=change-this-to-a-random-string
NEXTAUTH_URL=http://localhost:3000

# TTS Provider: "deepgram" (default) or "edge" (free Indian voices)
TTS_PROVIDER=deepgram
# Edge TTS settings (only when TTS_PROVIDER=edge)
EDGE_TTS_VOICE=en-IN-NeerjaNeural
EDGE_TTS_RATE=+10%

# Proctoring
NEXT_PUBLIC_MAX_PROCTORING_STRIKES=20

# Email (optional - falls back to console logging)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Speech-to-text backend ─────────────────────────────────────────────
# STT_PROVIDER: deepgram (default) | soniox | sarvam | voxtral (self-hosted Mistral Voxtral Realtime)
STT_PROVIDER=deepgram
STT_LANGUAGE=en-IN
# Deepgram only: comma-separated key terms to boost (default: built-in technical list). "none" disables.
# STT_KEYTERMS=

# Voxtral (STT_PROVIDER=voxtral) — a vLLM server running mistralai/Voxtral-Mini-4B-Realtime-2602
# Browser audio switches to raw 16 kHz PCM automatically (served via /api/config as sttAudio=pcm16).
# VOXTRAL_URL=ws://voxtral-stt:8000
# VOXTRAL_MODEL=mistralai/Voxtral-Mini-4B-Realtime-2602
# VOXTRAL_API_KEY=            # only if vLLM was started with --api-key
# VOXTRAL_ENDPOINT_MS=700     # ms of no new text before an utterance counts as finished
